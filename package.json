{
  "name": "askching",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "live:smoke": "DEMO_LIVE=1 tsx --env-file=.env demos/live-smoke.ts",
    "demo": "DEMO_LIVE=0 tsx --env-file=.env demos/demo.ts",
    "demo:live": "DEMO_LIVE=1 tsx --env-file=.env demos/demo.ts --live",
    "askching": "node --env-file=.env packages/grok-orchestrator/dist/index.js",
    "mcp:smoke": "pnpm -C packages/mcp-server build && tsx packages/mcp-server/src/mcp-smoke.ts",
    "mcp:serve": "pnpm -C packages/mcp-server build && node --env-file=.env packages/mcp-server/dist/serve.js",
    "mcp:http:smoke": "pnpm -C packages/mcp-server build && tsx packages/mcp-server/src/http-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
