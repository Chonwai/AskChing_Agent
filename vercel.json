{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/*.ts": {
      "includeFiles": [
        "packages/shared/dist/**",
        "packages/mcp-server/dist/**"
      ],
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }]
}
