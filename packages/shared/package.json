{
  "name": "@askching/shared",
  "version": "0.1.0",
  "description": "Shared types, schemas, and data sources for AskChing.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "keywords": [
    "defi",
    "the-graph",
    "market-data",
    "research"
  ],
  "engines": {
