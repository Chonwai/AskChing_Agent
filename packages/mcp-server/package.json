{
  "name": "@askching/mcp-server",
  "version": "0.1.0",
  "description": "AskChing MCP server: cited multi-subgraph DeFi market research over stdio or remote Streamable HTTP.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools.js": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./http.js": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "bin": {
    "askching-mcp": "dist/index.js",
    "askching-mcp-http": "dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "defi",
    "the-graph",
    "research",
    "ai-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/serve.js"
  },
  "dependencies": {
    "@askching/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  }
}
